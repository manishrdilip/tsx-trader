# India laptop settings. setup.ps1 copies this to ..\.env (repo folder).
# Fill in every value, save, and close Notepad. Never commit .env.

# Kite Connect app (developers.kite.trade -> My apps)
KITE_API_KEY=
KITE_API_SECRET=

# Zerodha login used by the 8:15 AM token refresh
KITE_USER_ID=
KITE_PASSWORD=
# The base32 secret shown when you set up External TOTP (not the 6-digit code)
KITE_TOTP_SECRET=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude, used to verify trades
ANTHROPIC_API_KEY=

# Optional: also copy each day's token to the GitHub secret KITE_ACCESS_TOKEN.
# Leave blank unless you still run Kite workflows on GitHub.
GH_TOKEN=
